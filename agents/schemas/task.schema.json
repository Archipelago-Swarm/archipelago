{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archipelago/agents/task.schema.json",
  "title": "Task ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "state", "priority", "owner", "machine", "branch",
    "created_at", "updated_at", "dependencies", "blocked_by", "owned_paths", "contracts",
    "acceptance", "retry_policy", "last_good_commit", "artifacts", "handoff_file", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^T[0-9]{2,3}$"},
    "name": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "state": {"enum": ["QUEUED", "CLAIMED", "ACTIVE", "BLOCKED", "REVIEW", "INTEGRATION", "COMPLETE", "FAILED"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 9, "description": "0 is most urgent"},
    "owner": {"type": ["string", "null"], "description": "agent/worker id, e.g. B/network-worker-1"},
    "machine": {"enum": ["A", "B", null], "description": "QUEUED: preferred machine (null = any). Otherwise the machine that holds the claim."},
    "branch": {"type": ["string", "null"], "pattern": "^(agent|claude)/[A-Za-z0-9._/-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{2,3}$"}, "uniqueItems": true},
    "blocked_by": {"type": "array", "items": {"type": "string", "minLength": 3}, "description": "Task ids or 'human:<what is needed>' / 'env:<what is missing>'"},
    "owned_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "contracts": {"type": "array", "items": {"type": "string"}},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "assertions"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "expected_exit_code"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "expected_exit_code": {"type": "integer"},
              "tier": {"enum": ["fast", "integration", "full"]},
              "needs": {"type": "array", "items": {"enum": ["docker", "network", "credentials"]}}
            }
          }
        },
        "assertions": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["description"],
            "properties": {"description": {"type": "string", "minLength": 5}}}
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_failure", "build_failure", "integration_failure", "same_failure_signature"],
      "properties": {
        "test_failure": {"type": "integer", "minimum": 1},
        "build_failure": {"type": "integer", "minimum": 1},
        "integration_failure": {"type": "integer", "minimum": 1},
        "same_failure_signature": {"type": "integer", "minimum": 1}
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test_failure": {"type": "integer", "minimum": 0},
        "build_failure": {"type": "integer", "minimum": 0},
        "integration_failure": {"type": "integer", "minimum": 0},
        "signatures": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "last_good_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "handoff_file": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "event"],
        "properties": {
          "at": {"type": "string"},
          "event": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "by": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
