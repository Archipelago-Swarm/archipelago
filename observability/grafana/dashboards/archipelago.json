{
  "uid": "archipelago-run",
  "title": "Archipelago run",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "type": "query",
        "label": "Run",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tigerdata"
        },
        "query": "SELECT run_id FROM runs ORDER BY started_at DESC",
        "refresh": 2,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Coverage",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No data"
        },
        "overrides": []
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerdata"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, node_id AS metric, value FROM metrics WHERE run_id = ${run_id:sqlstring} AND name = 'coverage_ratio' AND $__timeFilter(ts) ORDER BY ts"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Transfer",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data"
        },
        "overrides": []
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerdata"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, node_id AS metric, value FROM metrics WHERE run_id = ${run_id:sqlstring} AND name = 'transfer_bytes' AND $__timeFilter(ts) ORDER BY ts"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data"
        },
        "overrides": []
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerdata"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, node_id AS metric, value FROM metrics WHERE run_id = ${run_id:sqlstring} AND name = 'latency_ms' AND $__timeFilter(ts) ORDER BY ts"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Failures and dropped rows",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tigerdata"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, node_id, kind, payload FROM events WHERE run_id = ${run_id:sqlstring} AND kind LIKE '%fail%' AND $__timeFilter(ts) UNION ALL SELECT ts, 'writer', kind, jsonb_build_object('dropped', dropped) FROM dropped_metrics WHERE run_id = ${run_id:sqlstring} AND $__timeFilter(ts) ORDER BY 1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      }
    }
  ]
}
