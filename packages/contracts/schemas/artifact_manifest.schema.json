{
  "additionalProperties": false,
  "properties": {
    "commit": {
      "pattern": "^[0-9a-f]{7,40}$",
      "title": "Commit",
      "type": "string"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "format": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Format Version",
      "type": "string"
    },
    "kind": {
      "const": "artifact_manifest",
      "default": "artifact_manifest",
      "title": "Kind",
      "type": "string"
    },
    "node_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Node Id"
    },
    "path": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
      "title": "Path",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^0\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "sim_tick": {
      "minimum": 0,
      "title": "Sim Tick",
      "type": "integer"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "node_id",
    "sim_tick",
    "path",
    "sha256",
    "format",
    "format_version",
    "size_bytes",
    "commit",
    "config_hash"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}
