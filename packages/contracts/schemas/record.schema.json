    },
    {
      "$ref": "#/$defs/WorldSnapshot"
    },
    {
      "$ref": "#/$defs/PeerEnvelope"
    },
    {
      "$ref": "#/$defs/LearningEvent"
    },
    {
      "$ref": "#/$defs/MetricSample"
    },
    {
