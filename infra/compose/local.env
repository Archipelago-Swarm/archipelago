# DEV-ONLY values for `make demo` (compose --profile local). Not secrets: they protect nothing and the
# local stack publishes only the proxy on localhost. NEVER use this file for a deployed (non-local) stack;
# production uses infra/compose/.env (see .env.example), which has no defaults.
# Passed after .env.example, so these override its empty values.
IMAGE_TAG=dev
SITE_ADDRESS=http://localhost
ARCHIPELAGO_ALLOWED_ORIGINS=http://localhost
ARCHIPELAGO_COOKIE_SECURE=false
ARCHIPELAGO_API_TOKEN=dev-only-api-token-0123456789abcdef
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-0123456789
NODE_CONTROL_TOKEN=dev-only-node-control-token-0123456789
PEER_TOKEN=dev-only-peer-token-0123456789
TELEMETRY_TOKEN=dev-only-telemetry-token-0123456789
COORDINATOR_TOKEN=dev-only-coordinator-token-0123456789
COORDINATOR_ADMIN_TOKEN=dev-only-coordinator-admin-token-0123
LOCAL_DB_PASSWORD=local-dev-only
