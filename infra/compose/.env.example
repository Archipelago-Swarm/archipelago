# Copy to infra/compose/.env on the host (chmod 600). NEVER commit the real file.
IMAGE_TAG=dev
SITE_ADDRESS=localhost
ACME_EMAIL=
# >= 16 chars; generate with: openssl rand -hex 24
ARCHIPELAGO_API_TOKEN=
ARCHIPELAGO_ALLOWED_ORIGINS=https://localhost
# Login cookie Secure attribute. Default true (correct behind Caddy TLS). Set false ONLY for
# plain-HTTP local development; browsers will not send a Secure cookie over http.
ARCHIPELAGO_COOKIE_SECURE=true
# generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
# Production (profile "prod"): TigerData TLS. Writer role for the API, read-only role for Grafana.
TIGERDATA_URL=
TIGERDATA_GRAFANA_HOST=
TIGERDATA_GRAFANA_USER=
TIGERDATA_GRAFANA_PASSWORD=
TIGERDATA_GRAFANA_SSLMODE=require
# Local profile only
LOCAL_DB_PASSWORD=local-dev-only

# Live runtime secrets. REQUIRED, no defaults: compose refuses to start with any of these empty.
# Each >= 16 chars and distinct; generate with: openssl rand -hex 24
# (`make demo` uses the dev-only values in infra/compose/local.env instead.)
NODE_CONTROL_TOKEN=
PEER_TOKEN=
TELEMETRY_TOKEN=
COORDINATOR_TOKEN=
COORDINATOR_ADMIN_TOKEN=
# Optional run selection (see infra/demo/README.md). Smoke: 150 ticks; demo: 900 ticks.
# DEMO_PLAN=smoke
# DEMO_MAX_TICKS=150
# DEMO_BATTERY_SCALE=4   # must be >= 4 for the 900-tick demo (A13)
# DEMO_SEED=0
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
