# Copy to infra/compose/.env on the host (chmod 600). NEVER commit the real file.
IMAGE_TAG=dev
SITE_ADDRESS=localhost
ACME_EMAIL=
# >= 16 chars; generate with: openssl rand -hex 24
ARCHIPELAGO_API_TOKEN=
ARCHIPELAGO_ALLOWED_ORIGINS=https://localhost
# generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
# Production (profile "prod"): TigerData TLS. Writer role for the API, read-only role for Grafana.
TIGERDATA_URL=
TIGERDATA_GRAFANA_HOST=
TIGERDATA_GRAFANA_USER=
TIGERDATA_GRAFANA_PASSWORD=
TIGERDATA_GRAFANA_SSLMODE=require
# Local profile only
LOCAL_DB_PASSWORD=local-dev-only
