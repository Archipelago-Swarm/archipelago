{
  "name": "archipelago-workspace",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:types": "npm run gen -w @archipelago/contracts",
    "lint": "eslint apps packages --max-warnings 0",
    "typecheck": "npm run typecheck -w @archipelago/web && npm run typecheck -w @archipelago/contracts",
    "test": "npm run test -w @archipelago/contracts && npm run test -w @archipelago/web",
    "build": "npm run build -w @archipelago/web"
  },
  "type": "module",
  "devDependencies": {
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
